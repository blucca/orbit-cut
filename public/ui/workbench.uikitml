<style>
  .controls { width: 66; flex-direction: column; gap: 1.2; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; background-color: #171b35; border-radius: 1.2; }
  .row { flex-direction: row; justify-content: space-between; align-items: center; gap: 1; }
  .title { font-size: 3.3; font-weight: 700; color: #f4ebd9; }
  .small { font-size: 1.7; color: #b7bad1; }
  .status { font-size: 2; color: #f5a15e; }
  .button { background-color: #292e50; border-radius: 0.6; padding-top: 1.3; padding-bottom: 1.3; padding-left: 1.8; padding-right: 1.8; }
  .button-text { font-size: 1.8; color: #f4ebd9; }
</style>
<div class="controls" id="panel-surface">
  <div class="row">
    <span class="title">Orbit Cut</span>
    <span class="small">Keep the story in view.</span>
  </div>
  <span class="small" id="hint">Pinch the orange wheel. Turn until both subjects line up.</span>
  <div class="row">
    <span class="status" id="yaw-status">Loading demo video...</span>
    <span class="small" id="time-status">Before | After</span>
  </div>
  <div class="row">
    <button class="button" id="turn-left"><span class="button-text">Turn -5</span></button>
    <button class="button" id="replay-cut"><span class="button-text">Replay cut</span></button>
    <button class="button" id="reset-yaw"><span class="button-text">Reset</span></button>
    <button class="button" id="turn-right"><span class="button-text">Turn +5</span></button>
    <button class="button" id="export-mp4"><span class="button-text">Export MP4</span></button>
  </div>
</div>
