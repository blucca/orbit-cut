<style>
  .controls { width: 66; flex-direction: column; gap: 1.2; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; background-color: #171b35; border-radius: 1.2; }
  .row { flex-direction: row; justify-content: space-between; align-items: center; gap: 1; }
  .title { width: 22; font-size: 3; font-weight: 700; color: #f4ebd9; }
  .small { font-size: 1.7; color: #b7bad1; }
  #hint { height: 4.4; }
  .task { width: 38; flex-direction: column; gap: 0.4; }
  .task-title { font-size: 2.2; font-weight: 700; color: #f4ebd9; }
  .next-text { font-size: 1.9; font-weight: 700; color: #171b35; }
  .status { font-size: 2; color: #f5a15e; }
  .button { background-color: #292e50; border-radius: 0.6; padding-top: 1.3; padding-bottom: 1.3; padding-left: 1.8; padding-right: 1.8; }
  .next { width: 22; align-items: center; background-color: #f5a15e; }
  .button-text { font-size: 1.8; color: #f4ebd9; }
  .cut { width: 22; align-items: center; }
  .small-button { background-color: #292e50; border-radius: 0.6; padding-top: 1; padding-bottom: 1; padding-left: 1.5; padding-right: 1.5; }
</style>
<div class="controls" id="panel-surface">
  <div class="row">
    <span class="title">Orbit Cut</span>
    <button class="button" id="review-panorama"><span class="button-text" id="review-label">Review 360</span></button>
    <button class="button" id="pause-work"><span class="button-text" id="work-pause-label">Pause</span></button>
  </div>
  <div class="row" id="task-banner">
    <div class="task">
      <span class="small" id="task-progress">Two cuts, one story</span>
      <span class="task-title" id="task-title">Keep the beacon in view</span>
    </div>
    <button class="button next" id="task-next"><span class="next-text" id="task-next-label">Replay cut</span></button>
  </div>
  <span class="small" id="hint">Pinch the orange wheel. Turn until both subjects line up.</span>
  <div class="row" id="cut-controls">
    <button class="small-button cut" id="cut-1"><span class="button-text" id="cut-1-label">Cut 1</span></button>
    <button class="small-button cut" id="cut-2"><span class="button-text" id="cut-2-label">Cut 2</span></button>
    <button class="small-button" id="cut-timing"><span class="button-text" id="cut-timing-label">Timing</span></button>
  </div>
  <div class="row" id="boundary-controls" style="display: none;">
    <button class="small-button" id="add-cut" style="display: none;"><span class="button-text">Add cut</span></button>
    <button class="small-button" id="remove-cut"><span class="button-text">Remove</span></button>
    <button class="small-button" id="earlier-second"><span class="button-text">-1 s</span></button>
    <button class="small-button" id="earlier-frame"><span class="button-text">-0.1 s</span></button>
    <button class="small-button" id="later-frame"><span class="button-text">+0.1 s</span></button>
    <button class="small-button" id="later-second"><span class="button-text">+1 s</span></button>
  </div>
  <div class="row" id="yaw-row">
    <span class="status" id="yaw-status">Loading demo video...</span>
    <span class="small" id="time-status">Before | After</span>
  </div>
  <div class="row" id="turn-row">
    <button class="button" id="turn-left"><span class="button-text">Turn -5</span></button>
    <button class="button" id="replay-cut"><span class="button-text">Replay cut</span></button>
    <button class="button" id="reset-yaw"><span class="button-text">Reset</span></button>
    <button class="button" id="turn-right"><span class="button-text">Turn +5</span></button>
    <button class="button" id="export-mp4"><span class="button-text">Export MP4</span></button>
  </div>
  <div class="row" id="review-controls" style="display: none;">
    <button class="button" id="review-original"><span class="button-text">Original</span></button>
    <button class="button" id="review-corrected"><span class="button-text">Corrected</span></button>
    <button class="button" id="review-replay"><span class="button-text">Replay film</span></button>
    <button class="button" id="review-pause"><span class="button-text" id="pause-label">Pause</span></button>
    <button class="button" id="review-export"><span class="button-text">Export MP4</span></button>
  </div>
  <span class="small" id="review-status" style="display: none;">Corrected panorama. Look around to check the cut.</span>
</div>
